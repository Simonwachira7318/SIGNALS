# Copy to .env and fill in. .env is git-ignored; never commit it.
# Real environment variables (setx / $env:) override these values.

# MySQL (XAMPP)
WIFI_SENSE_DB_HOST=localhost
WIFI_SENSE_DB_PORT=3306
WIFI_SENSE_DB_USER=root
WIFI_SENSE_DB_PASSWORD=

# Telegram phone alerts + daily summary (optional, see README)
WIFI_SENSE_TELEGRAM_TOKEN=
WIFI_SENSE_TELEGRAM_CHAT=

# Dashboard port
WIFI_SENSE_PORT=8765

# Network access for phone / remote nodes (off by default). Setting BIND to 0.0.0.0
# REQUIRES an access token of 16+ characters; anything but this PC's browser must present it.
# WIFI_SENSE_BIND=0.0.0.0
# WIFI_SENSE_ACCESS_TOKEN=

# On a remote node (node.py / WiFiSenseNode.exe)
# WIFI_SENSE_HUB=http://192.168.0.10:8765
# WIFI_SENSE_NODE_NAME=kitchen
